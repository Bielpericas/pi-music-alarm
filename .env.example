# Copia este fichero como .env y rellena los valores. .env NO se sube a git.

# Clave para firmar la sesión de Flask (genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Spotify Developer Dashboard -> tu app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la Redirect URI registrada en el Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/spotify/callback
# Opcional: nombre del dispositivo de las alarmas si aún no has pulsado
# «Seleccionar» en la página Spotify (el nombre de Raspotify, p. ej. Groove).
# SPOTIFY_DEVICE_NAME=Groove

# Opcionales
# ALARM_SOUND=C:\ruta\a\mi_sonido.wav      (en la Pi: /home/<usuario>/mi_sonido.wav)
# AUDIO_BACKEND=local                       (none = sin sonido)

# Solo Raspberry Pi / Linux: tarjeta de sonido para aplay. Mírala con `aplay -L`.
# Vacío = la tarjeta por defecto de ALSA. Ejemplo con una tarjeta USB:
# ALSA_DEVICE=plughw:CARD=Device,DEV=0

# Música local (instance/music/): la reproduce ffmpeg por ALSA_DEVICE; si
# ALSA_DEVICE está vacío, por plughw:CARD=Device,DEV=0.
# FFMPEG_BINARY=ffmpeg
# Tamaño máximo de cada archivo subido desde la página Música (MB).
# LOCAL_MUSIC_MAX_UPLOAD_MB=50

# Solo Raspberry Pi: servicio systemd del reproductor Bluetooth (BlueALSA) que
# se para mientras suena una alarma y se vuelve a arrancar tras STOP / +10 MIN.
# Necesita la regla de polkit (bash deploy/install-bluetooth-permission.sh).
# none = no gestionar Bluetooth.
# BLUETOOTH_SERVICE=bluealsa-aplay

# Página Bluetooth (BlueZ: dispositivos y ventana de emparejamiento de 2 minutos).
# Al arrancar, Groove deja Bluetooth en privado (discoverable/pairable off).
# off = no tocar BlueZ desde Groove.
# BLUEZ_MANAGEMENT=on

# Diagnóstico y pre-flight (solo consultan el estado; nunca arrancan ni paran nada).
# Minutos antes de cada alarma en que se ejecutan los health checks (0 = sin pre-flight).
# ALARM_PREFLIGHT_MINUTES=5
# Servicios systemd que se consultan (none = no comprobar).
# RASPOTIFY_SERVICE=raspotify
# BLUEALSA_SERVICE=bluealsa

# Solo `python serve.py` (producción / servicio systemd)
# HOST=0.0.0.0          (0.0.0.0 = accesible desde la red local)
# PORT=5000
# THREADS=4
